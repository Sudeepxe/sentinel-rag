# Copy to .env and fill in only what you need. Nothing here is required
# for the default deterministic benchmark, tests, or CI.

# --- Real LLM generation providers (optional; deterministic_local needs none) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Storage (optional; local JSON files are the zero-config default) ---
# Used only if you wire a Postgres-backed sentinel.storage implementation;
# see docker-compose.yml for a local pgvector service definition.
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel_rag

# --- Observability (optional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_MULTIPROC_DIR=

# --- API service (optional) ---
SENTINEL_API_HOST=0.0.0.0
SENTINEL_API_PORT=8000
